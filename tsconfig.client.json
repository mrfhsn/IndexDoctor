{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist/client-types",
    "rootDir": "./src/client"
  },
  "references": [{ "path": "./tsconfig.shared.json" }],
  "include": ["src/client/**/*"],
  "exclude": ["src/client/**/*.test.ts"]
}
