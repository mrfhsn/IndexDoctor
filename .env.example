# Server Configuration
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# Gemini API Configuration (Secret)
GEMINI_API_KEY=
LLM_MODELS=gemini-3.1-flash-lite,gemma-4-26b-a4b-it,gemini-3.5-flash-lite
LLM_THINKING_LEVEL=minimal
LLM_ATTEMPT_TIMEOUT_MS=8000
LLM_BUDGET_MS=15000
LLM_MAX_CONCURRENCY=6
LLM_DAILY_CAP=1500
LLM_BREAKER_COOLDOWN_MS=60000

# Pipeline Budgets and Limits
REQUEST_DEADLINE_MS=30000
MAX_BODY_BYTES=32768
MAX_SCHEMA_BYTES=20000
MAX_QUERY_BYTES=8000
MAX_IN_FLIGHT=24

# Sandbox Configuration
SANDBOX_QUEUE_MAX=12
SANDBOX_QUEUE_WAIT_MS=5000
SANDBOX_JOB_TIMEOUT_MS=6000
SANDBOX_SEED_ROWS=20000
ASSUMED_ROW_COUNT=500000
SANDBOX_RECYCLE_JOBS=300

# Edge and Rate Limiting
RATE_LIMIT_PER_MIN=12
RATE_LIMIT_BURST=6
TRUSTED_PROXY_HOPS=1

# In-Memory Cache
CACHE_MAX_ENTRIES=200
CACHE_TTL_MS=3600000
